/* ===== 猛攻武器铺 · iOS 毛玻璃暗色主题 ===== */
page {
  background: #0b0d16;
  background-image:
    radial-gradient(circle at 12% 6%, rgba(232, 182, 76, 0.18), transparent 34%),
    radial-gradient(circle at 90% 12%, rgba(78, 156, 255, 0.14), transparent 30%),
    radial-gradient(circle at 78% 86%, rgba(76, 175, 116, 0.12), transparent 38%),
    linear-gradient(180deg, #121523 0%, #0b0d16 55%, #0e1018 100%);
  color: #eef0f6;
  font-size: 28rpx;
  min-height: 100%;
}

.page {
  padding: 24rpx 28rpx 48rpx;
}

/* ---------- 毛玻璃卡片 ---------- */
.card {
  background: rgba(255, 255, 255, 0.06);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  padding: 26rpx;
  margin-bottom: 22rpx;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #f2ca66 0%, #d9a832 100%);
  color: #14151f;
  font-weight: 700;
  border-radius: 18rpx;
  text-align: center;
  padding: 22rpx 0;
  box-shadow: 0 12rpx 32rpx rgba(232, 182, 76, 0.28);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.07);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #eef0f6;
  border-radius: 18rpx;
  text-align: center;
  padding: 22rpx 0;
}

.muted {
  color: #9aa1b3;
  font-size: 24rpx;
}

/* ---------- 搜索框 ---------- */
.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  background: rgba(255, 255, 255, 0.07);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  color: #eef0f6;
}

.search-placeholder {
  color: #6d7488;
}

/* ---------- 筛选标签 ---------- */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #b9bfcf;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
}

.filter-tag.active {
  background: linear-gradient(135deg, #f2ca66 0%, #d9a832 100%);
  border-color: transparent;
  color: #14151f;
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(232, 182, 76, 0.28);
}

/* ---------- 通用小标签 ---------- */
.tag {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  color: #c5cbda;
  border-radius: 10rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
}

.tag-price {
  color: #f0c75e;
  background: rgba(232, 182, 76, 0.12);
  border-color: rgba(232, 182, 76, 0.22);
}

/* ---------- 区块标题 ---------- */
.section-title {
  display: flex;
  align-items: center;
  margin: 28rpx 6rpx 18rpx;
  font-weight: 700;
  color: #eef0f6;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #f2ca66, #d9a832);
  margin-right: 14rpx;
  box-shadow: 0 0 14rpx rgba(232, 182, 76, 0.6);
}

/* ---------- 枪械贴图 ---------- */
.gun-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background-color: rgba(232, 182, 76, 0.08);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 78% 78%;
  border: 1rpx solid rgba(232, 182, 76, 0.2);
  box-shadow: inset 0 0 24rpx rgba(232, 182, 76, 0.08);
  flex-shrink: 0;
}

.gun-thumb.sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background-size: 78% 78%;
}

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 90rpx 0;
}

.empty .muted {
  font-size: 26rpx;
}
