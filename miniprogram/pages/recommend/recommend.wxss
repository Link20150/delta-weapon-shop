/* ---------- 英雄横幅 ---------- */
.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 30rpx;
  background:
    radial-gradient(circle at 82% 20%, rgba(232, 182, 76, 0.22), transparent 42%),
    rgba(255, 255, 255, 0.06);
  border-color: rgba(232, 182, 76, 0.22);
}

.hero-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #f0c75e;
  background: rgba(232, 182, 76, 0.14);
  border: 1rpx solid rgba(232, 182, 76, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #f7d27e, #d9a832);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  margin-top: 10rpx;
}

.hero-mascot {
  width: 150rpx;
  height: 150rpx;
  margin-left: 20rpx;
  filter: drop-shadow(0 8rpx 20rpx rgba(232, 182, 76, 0.35));
}

/* ---------- 每日推荐卡片 ---------- */
.daily-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
}

.daily-body {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.daily-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.daily-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.tag {
  margin: 0 10rpx 10rpx 0;
}

.daily-reason {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.daily-copy {
  font-size: 26rpx;
  padding: 14rpx 0;
}

.arsenal-entry {
  margin-top: 30rpx;
  font-size: 28rpx;
}
