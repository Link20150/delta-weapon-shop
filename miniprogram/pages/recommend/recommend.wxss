/* ---------- 英雄横幅 ---------- */
.hero-card {
  padding: 36rpx 30rpx;
  background:
    radial-gradient(circle at 85% 20%, rgba(52, 199, 89, 0.2), transparent 45%),
    rgba(255, 255, 255, 0.06);
  border-color: rgba(52, 199, 89, 0.22);
}

.hero-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #5ce184;
  background: rgba(52, 199, 89, 0.14);
  border: 1rpx solid rgba(52, 199, 89, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #7ff0a3, #2fae57);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  margin-top: 10rpx;
}

/* ---------- 每日推荐卡片 ---------- */
.daily-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.daily-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.tag {
  margin: 0 10rpx 10rpx 0;
}

.daily-reason {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.daily-copy {
  font-size: 26rpx;
  padding: 14rpx 0;
}

.arsenal-entry {
  margin-top: 30rpx;
  font-size: 28rpx;
}
