<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索枪名，如 K416"
      placeholder-class="search-placeholder"
      value="{{query}}"
      bindinput="onQueryInput"
      confirm-type="search"
    />
  </view>

  <view class="filters">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view
        class="filter-tag {{activeCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </scroll-view>
  </view>

  <view class="muted count-tip" wx:if="{{!loading}}">已收录 {{covered}} / {{total}} 把枪的方案</view>

  <view class="empty muted" wx:if="{{loading}}">加载中…</view>
  <view class="empty muted" wx:elif="{{!sections.length}}">没有找到对应的枪，换个关键字试试</view>

  <block wx:for="{{sections}}" wx:key="category" wx:for-item="section">
    <view class="section-title">{{section.category}}</view>
    <view class="gun-row card" wx:for="{{section.guns}}" wx:key="key" wx:for-item="gun" data-gun="{{gun}}" bindtap="goGun">
      <view class="gun-cell">
        <view class="gun-name">{{gun.name}}</view>
        <view class="muted gun-sub">{{gun.count ? '有 ' + gun.count + ' 套方案' : '暂无方案'}}</view>
      </view>
      <view class="gun-badge {{gun.count ? 'has' : ''}}">{{gun.count ? gun.count + ' 套' : '暂无'}}</view>
    </view>
  </block>
</view>
