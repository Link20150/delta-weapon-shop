<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索枪名，如 K416"
      placeholder-class="search-placeholder"
      value="{{query}}"
      bindinput="onQueryInput"
      confirm-type="search"
    />
  </view>

  <view class="filters">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view
        class="filter-tag {{priceLevel === item ? 'active' : ''}}"
        wx:for="{{priceLevels}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onPriceTap"
      >{{item}}</view>
    </scroll-view>
  </view>

  <view class="empty muted" wx:if="{{!list.length}}">没有找到匹配的方案，换个条件试试</view>

  <view class="code-card card" wx:for="{{list}}" wx:key="id" data-index="{{index}}" bindtap="goDetail">
    <view class="code-header">
      <view class="code-name">{{item.gunName}} · {{item.configName}}</view>
      <view class="code-price">￥{{item.priceLevel}}</view>
    </view>
    <view class="code-tags">
      <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="code-row">
      <view class="code-text muted">{{item.code}}</view>
      <view class="code-copy" catchtap="copyCode" data-code="{{item.code}}">复制</view>
    </view>
  </view>
</view>
