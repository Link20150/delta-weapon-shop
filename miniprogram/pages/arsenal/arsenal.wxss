.count-tip {
  margin: 4rpx 4rpx 16rpx;
}

.gun-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.gun-name {
  font-size: 30rpx;
  font-weight: 600;
}

.gun-sub {
  margin-top: 4rpx;
}

.gun-badge {
  flex-shrink: 0;
  background: #242738;
  color: #5d6272;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
}

.gun-badge.has {
  background: #2a2f18;
  color: #e8b64c;
}
