.count-tip {
  margin: 4rpx 4rpx 16rpx;
  color: #9aa1b3;
}

.gun-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
}

.gun-cell {
  flex: 1;
  min-width: 0;
}

.gun-name {
  font-size: 30rpx;
  font-weight: 600;
}

.gun-sub {
  margin-top: 4rpx;
}

.gun-badge {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  color: #6d7488;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
}

.gun-badge.has {
  background: rgba(52, 199, 89, 0.12);
  border-color: rgba(52, 199, 89, 0.24);
  color: #5ce184;
}
