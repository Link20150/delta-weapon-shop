.search-bar {
  margin-bottom: 20rpx;
}

.search-input {
  background: #1a1c29;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

.search-placeholder {
  color: #5d6272;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.filter-tag {
  display: inline-block;
  background: #1a1c29;
  color: #aab0c0;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
}

.filter-tag.active {
  background: #e8b64c;
  color: #14151f;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.code-name {
  font-size: 30rpx;
  font-weight: 600;
}

.code-price {
  color: #e8b64c;
}

.code-tags {
  margin-bottom: 12rpx;
}

.tag {
  background: #242738;
  color: #aab0c0;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-text {
  flex: 1;
  font-size: 22rpx;
  word-break: break-all;
  margin-right: 16rpx;
}

.code-copy {
  flex-shrink: 0;
  background: #e8b64c;
  color: #14151f;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 10rpx;
  padding: 10rpx 26rpx;
}
