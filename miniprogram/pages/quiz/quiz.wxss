.group {
  margin-bottom: 28rpx;
}

.group-title {
  color: #e8b64c;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
}

.option {
  background: #1a1c29;
  color: #aab0c0;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  margin: 0 16rpx 14rpx 0;
}

.option.active {
  background: #e8b64c;
  color: #14151f;
  font-weight: 600;
}

.submit-btn {
  margin: 12rpx 0 32rpx;
}

.section-title {
  color: #e8b64c;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
