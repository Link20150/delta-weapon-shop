<view class="page">
  <view class="group">
    <view class="group-title">地图难度</view>
    <view class="option-row">
      <view
        class="option {{difficulty === item ? 'active' : ''}}"
        wx:for="{{difficulties}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onDifficulty"
      >{{item}}</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">预算档位</view>
    <view class="option-row">
      <view
        class="option {{priceLevel === item ? 'active' : ''}}"
        wx:for="{{priceLevels}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onPrice"
      >{{item}}</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">偏好（可多选）</view>
    <view class="option-row">
      <view
        class="option {{item.active ? 'active' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-value="{{item.name}}"
        bindtap="onTag"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="btn-primary submit-btn" bindtap="submit">开始推荐</view>

  <block wx:if="{{submitted}}">
    <view class="section-title">为你推荐</view>
    <view class="empty muted" wx:if="{{!result.length}}">没有完全匹配的方案，试试放宽预算档位</view>
    <view class="card result-card" wx:for="{{result}}" wx:key="id" data-index="{{index}}" bindtap="goDetail">
      <view class="result-name">{{item.gunName}} · {{item.configName}}</view>
      <view class="result-meta muted">{{item.mode}} · {{item.priceLevel}}预算 · 匹配 {{item.score}} 个偏好</view>
    </view>
  </block>
</view>
