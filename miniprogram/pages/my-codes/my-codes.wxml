<view class="page">
  <view class="card">
    <view class="form-label">改枪码</view>
    <textarea
      class="code-input"
      placeholder="从游戏内复制的改枪码粘贴到这里"
      placeholder-class="input-placeholder"
      value="{{code}}"
      data-field="code"
      bindinput="onInput"
      maxlength="-1"
    />
    <view class="form-label">枪名（可选）</view>
    <input class="form-input" placeholder="如 K416" placeholder-class="input-placeholder" value="{{gunName}}" data-field="gunName" bindinput="onInput" />
    <view class="form-label">配置名（可选）</view>
    <input class="form-input" placeholder="如 朋友给的压枪款" placeholder-class="input-placeholder" value="{{configName}}" data-field="configName" bindinput="onInput" />
    <view class="btn-primary save-btn" bindtap="save">保存</view>
  </view>

  <view class="section-title">我的代码（{{list.length}}）</view>
  <view class="empty muted" wx:if="{{!list.length}}">还没有保存的代码</view>
  <view class="card my-card" wx:for="{{list}}" wx:key="id">
    <view class="my-name">{{item.gunName}}{{item.configName ? ' · ' + item.configName : ''}}</view>
    <view class="my-code muted">{{item.code}}</view>
    <view class="my-actions">
      <view class="action-btn" catchtap="copy" data-code="{{item.code}}">复制</view>
      <view class="action-btn danger" catchtap="remove" data-id="{{item.id}}">删除</view>
    </view>
  </view>
</view>
