.detail-head {
  padding: 32rpx 30rpx;
  background:
    radial-gradient(circle at 85% 15%, rgba(52, 199, 89, 0.14), transparent 45%),
    rgba(255, 255, 255, 0.06);
}

.detail-title {
  font-size: 44rpx;
  font-weight: 800;
}

.detail-subtitle {
  color: #5ce184;
  margin-top: 8rpx;
}

.detail-meta {
  margin-bottom: 16rpx;
}

.tag {
  margin-right: 10rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-weight: 700;
  color: #eef0f6;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #5ce184, #2fae57);
  margin-right: 14rpx;
}

.code-box {
  display: block;
  background: rgba(11, 13, 22, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.code-tip {
  margin-top: 12rpx;
}

.action-btn {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
