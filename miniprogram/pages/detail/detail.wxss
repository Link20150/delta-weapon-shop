.detail-title {
  font-size: 44rpx;
  font-weight: 700;
}

.detail-subtitle {
  color: #e8b64c;
  margin: 8rpx 0 16rpx;
}

.detail-meta {
  margin-bottom: 16rpx;
}

.tag {
  background: #242738;
  color: #aab0c0;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  margin-right: 10rpx;
}

.tag-price {
  color: #e8b64c;
}

.section-title {
  margin-bottom: 16rpx;
  font-weight: 600;
  color: #e8b64c;
}

.code-box {
  display: block;
  background: #0f1017;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.code-tip {
  margin-top: 12rpx;
}

.action-btn {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}
