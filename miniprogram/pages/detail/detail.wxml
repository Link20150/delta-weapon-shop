<view class="page" wx:if="{{code}}">
  <view class="card">
    <view class="detail-title">{{code.gunName}}</view>
    <view class="detail-subtitle">{{code.configName}}</view>
    <view class="detail-meta">
      <text class="tag">{{code.mode}}</text>
      <text class="tag tag-price">{{code.priceLevel}}预算</text>
      <text class="tag" wx:for="{{code.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="reason muted">{{code.reason}}</view>
  </view>

  <view class="card">
    <view class="section-title">改枪码</view>
    <text class="code-box" user-select="true">{{code.code}}</text>
    <view class="muted code-tip">复制后到游戏「改枪台 → 导入方案」粘贴即可</view>
  </view>

  <view class="btn-primary action-btn" bindtap="copy">复制改枪码</view>
  <view class="btn-ghost action-btn" bindtap="toggleFav">{{fav ? '取消收藏' : '收藏'}}</view>
</view>

<view class="page empty muted" wx:else>没有找到方案，请从枪库进入</view>
