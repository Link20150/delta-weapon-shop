.gun-head {
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 85% 15%, rgba(232, 182, 76, 0.16), transparent 45%),
    rgba(255, 255, 255, 0.06);
}

.gun-head-cell {
  margin-left: 22rpx;
}

.gun-name {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.code-top {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.code-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.code-name {
  font-size: 30rpx;
  font-weight: 700;
}

.code-price {
  color: #f0c75e;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.code-tags {
  margin-bottom: 6rpx;
}

.daily-reason {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-text {
  flex: 1;
  font-size: 22rpx;
  word-break: break-all;
  margin-right: 16rpx;
}

.code-copy {
  flex-shrink: 0;
  background: linear-gradient(135deg, #f2ca66 0%, #d9a832 100%);
  color: #14151f;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(232, 182, 76, 0.25);
}

.empty-btn {
  margin-top: 32rpx;
}
