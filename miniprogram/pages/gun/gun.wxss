.gun-head {
  padding: 30rpx;
  background:
    radial-gradient(circle at 85% 15%, rgba(52, 199, 89, 0.14), transparent 45%),
    rgba(255, 255, 255, 0.06);
}

.gun-name {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.code-name {
  font-size: 30rpx;
  font-weight: 700;
}

.code-price {
  color: #5ce184;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.code-tags {
  margin-bottom: 12rpx;
}

.daily-reason {
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.code-text {
  flex: 1;
  font-size: 22rpx;
  word-break: break-all;
  margin-right: 16rpx;
}

.code-copy {
  flex-shrink: 0;
  background: linear-gradient(135deg, #5ce184 0%, #2fae57 100%);
  color: #0f1410;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(52, 199, 89, 0.24);
}

.empty-btn {
  margin-top: 32rpx;
}
